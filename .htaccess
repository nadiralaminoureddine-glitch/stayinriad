# StayInRiad — page d'accueil : HTTPS obligatoire et protections du navigateur
Options -Indexes
RewriteEngine On
# laisser passer le renouvellement automatique du certificat SSL
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# www.stayinriad.com -> stayinriad.com
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# fichiers sensibles jamais servis
<FilesMatch "(^\.|\.(sql|bak|log|ini|key|zip)$)">
  Require all denied
</FilesMatch>
